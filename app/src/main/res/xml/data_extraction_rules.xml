<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep the encrypted API key out of cloud backup and device-to-device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure.xml" />
        <!-- Meal photos would soon pass Auto Backup's 25 MB cap, which stops the whole app's backup.
             The database still backs up; entries just show no photo after a restore. -->
        <exclude domain="file" path="food-photos/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure.xml" />
    </device-transfer>
</data-extraction-rules>
