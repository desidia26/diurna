<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays off globally. Named localhost aliases used by emulators and local
  gateways may use http. Private LAN IP ranges cannot be expressed here; those are
  enforced in-app by GatewayUrl (and still blocked by the platform unless Larry
  later approves weakening base-config — see the byo-gateway PR security notes).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
