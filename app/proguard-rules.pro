# Rules for the release build's code shrinker (R8). Most libraries ship their own; these cover
# what reaches code only through reflection.

# Anthropic SDK: models are (de)serialized by Jackson via reflection, including Kotlin metadata.
-keep class com.anthropic.** { *; }
-keep class com.fasterxml.jackson.** { *; }
-keep class kotlin.Metadata { *; }
-keepattributes Signature, InnerClasses, EnclosingMethod, *Annotation*, RuntimeVisible*Annotations, KotlinMetadata

# Readable stack traces in crash logs.
-keepattributes SourceFile, LineNumberTable

# Desktop-Java classes referenced by Jackson and the JSON-schema generator on code paths Android
# never takes (generated by AGP into missing_rules.txt).
-dontwarn java.beans.ConstructorProperties
-dontwarn java.beans.Transient
-dontwarn java.lang.reflect.AnnotatedParameterizedType
-dontwarn java.lang.reflect.AnnotatedType
