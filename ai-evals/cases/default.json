{
  "version": 1,
  "description": "Small default set for CI and local smoke runs. Keep cheap. Includes basic food, detailed/ingredients food, label OCR, menu photo, cardio.",
  "passThreshold": 0.7,
  "cases": [
    {
      "id": "food-burrito-bowl",
      "prompt": "food",
      "tags": [
        "typical"
      ],
      "input": {
        "text": "chipotle burrito bowl with chicken, brown rice, black beans, salsa, no guac, no cheese"
      },
      "expect": {
        "outcome": "estimate",
        "kcalMid": 620,
        "kcalTolPct": 45,
        "proteinG": {
          "min": 35,
          "max": 70
        },
        "carbsG": {
          "min": 55,
          "max": 110
        },
        "fatG": {
          "min": 8,
          "max": 30
        },
        "macrosConsistentWithKcal": true,
        "noteMaxLen": 120
      }
    },
    {
      "id": "food-apple",
      "prompt": "food",
      "tags": [
        "typical"
      ],
      "input": {
        "text": "one medium apple"
      },
      "expect": {
        "outcome": "estimate",
        "kcalMid": 95,
        "kcalTolPct": 50,
        "proteinG": {
          "min": 0,
          "max": 2
