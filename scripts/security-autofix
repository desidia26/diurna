#!/usr/bin/env bash
# The nightly's autofix, in two halves that run as separate jobs on separate machines, so the
# GitHub write token never shares a machine with code Claude may have edited: Gradle runs build
# scripts Claude can touch, and a Gradle daemon outlives the step that started it, so unsetting a
# variable or splitting steps wouldn't keep a token away from it. CI only.
#
#   scripts/security-autofix propose <findings-dir> <out-dir>
#       Read-only GitHub token, ANTHROPIC_API_KEY. Asks Claude for a fix, runs the unit tests, lint
#       and the security gate on it, and writes <out-dir>/outcome ("pr", "issue" or "skip"),
#       reason.txt, summary.md and change.patch.
#   scripts/security-autofix publish <findings-dir> <out-dir>
#       Write token. Runs nothing from the patch: applies it, checks which paths it touches, and
#       opens the PR, or the issue. Treats <out-dir> as untrusted (it came from the machine Claude's
#       edits ran on); the findings themselves are re-read from the security job's artifact.
#
# <findings-dir> is the nightly security job's artifact.
source "$(dirname "$0")/_lib.sh"

CLAUDE_CODE_VERSION=2.1.314
MODEL="${AUTOFIX_MODEL:-claude-opus-5-5}"
# Paths autofix may never change; checked in both halves, decisive in publish.
FORBIDDEN='^(\.github/|signing/|security/|scripts/|gradle/wrapper/|gradlew(\.bat)?$|CLAUDE\.md$|AGENTS\.md$)'
date="$(date -u +%F)"
branch="security/autofix-$date"
cd "$ROOT"

write_findings() { # write_findings <findings-dir> <out.json>
  local gate codeql
  gate="$(find "$1" -name gate.json | head -1)"
  codeql="$(find "$1" -name codeql.json | head -1)"
  python3 -I - "${gate:-/dev/null}" "${codeql:-/dev/null}" "$2" <<'EOF'
import json, sys
def load(p):
    try: return json.load(open(p))
    except Exception: return None
gate, codeql = load(sys.argv[1]) or {}, load(sys.argv[2]) or []
json.dump({"vulnerable_libraries": gate.get("blocking", []), "codeql_alerts": codeql}, open(sys.argv[3], "w"), indent=2)
EOF
}

changed_paths() { git status --porcelain --untracked-files=all | cut -c4-; }

propose() {
  local findings_dir="${1:?usage: scripts/security-autofix propose <findings-dir> <out-dir>}"
  local out="${2:?}"
  mkdir -p "$out"
  : >"$out/summary.md"
  finish() { # finish <outcome> [reason]
    printf '%s' "$1" >"$out/outcome"
    printf '%s' "${2:-}" >"$out/reason.txt"
    exit 0
  }

  # One fix in flight at a time: an open autofix PR means the next nightly just waits for it.
  if gh pr list --state open --json headRefName --jq '.[].headRefName' | grep -q '^security/autofix-'; then
    echo "An autofix PR is already open; not starting another."
    finish skip
  fi
  local anthropic_key="${ANTHROPIC_API_KEY:-}"
  unset GH_TOKEN GITHUB_TOKEN ANTHROPIC_API_KEY

  write_findings "$findings_dir" .security-findings.json
  trap 'rm -f .security-findings.json' EXIT
  local blocking
  blocking="$(python3 -I -c 'import json; d=json.load(open(".security-findings.json")); print(len(d["vulnerable_libraries"]) + len(d["codeql_alerts"]))')"
  (( blocking > 0 )) || finish issue "The gate failed without findings to fix: a scan didn't run or its results couldn't be read. See the nightly's Security job."
  [[ -n "$anthropic_key" ]] || finish issue "CLAUDE_AUTOFIX_KEY isn't set, so no fix was attempted."

  local work rc
  work="$(mktemp -d)"
  npm install --silent --no-audit --no-fund --prefix "$work/cli" "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION" >/dev/null
  set +e
  ANTHROPIC_API_KEY="$anthropic_key" "$work/cli/node_modules/.bin/claude" -p \
    "Resolve the blocking findings listed in .security-findings.json." \
    --bare --restricted --strict-mcp-config --no-session-persistence \
    --tools "Read,Grep,Glob,Edit,Write,Bash" \
    --allowedTools "Read" "Grep" "Glob" "Edit" "Write" "Bash(./gradlew:*)" "Bash(scripts/security-gate:*)" \
    --model "$MODEL" \
    --max-budget-usd "${AUTOFIX_BUDGET_USD:-10}" \
    --append-system-prompt-file security/autofix-prompt.md \
    --output-format json >"$work/answer.json" 2>"$work/stderr.txt"
  rc=$?
  set -e
  python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("result", "")[:3000])' "$work/answer.json" >"$out/summary.md" 2>/dev/null || true
  (( rc == 0 )) || finish issue "Claude didn't finish (exit $rc)."

  # Checked here, not taken on Claude's word.
  local changed
  changed="$(changed_paths)"
  [[ -n "$changed" ]] || finish issue "Claude found no safe fix and changed nothing."
  grep -qE "$FORBIDDEN" <<<"$changed" \
    && finish issue "The proposed change touched files autofix may not edit: $(tr '\n' ' ' <<<"$changed")"
  ./gradlew -q testDebugUnitTest lintRelease || finish issue "The proposed change broke the unit tests or lint."
  scripts/security-gate >/dev/null || finish issue "The proposed change didn't clear the security gate."

  git add -A
  git diff --cached --binary >"$out/change.patch"
  finish pr
}

publish() {
  local findings_dir="${1:?usage: scripts/security-autofix publish <findings-dir> <out-dir>}"
  local out="${2:?}"
  : "${GH_TOKEN:?}"
  local work
  work="$(mktemp -d)"
  # The body renderer is copied before the patch lands, so the patch can't change what renders it.
  cp scripts/security-autofix-body.py "$work/body.py"
  write_findings "$findings_dir" "$work/findings.json"
  # Claude's summary is escaped by the renderer; capped here as well.
  head -c 20000 "$out/summary.md" >"$work/summary.md" 2>/dev/null || : >"$work/summary.md"

  # Files a new issue, or adds the night's news to the one still open from an earlier night.
  open_issue() { # open_issue <why>
    python3 -I "$work/body.py" "$work/findings.json" "$1" "$work/summary.md" issue >"$work/issue.md"
    local existing
    existing="$(gh issue list --state open --label security --search 'in:title "Security gate blocked"' --json number --jq '.[0].number // empty')"
    if [[ -n "$existing" ]]; then
      gh issue comment "$existing" --body-file "$work/issue.md"
    else
      gh issue create --title "Security gate blocked the nightly (since $date)" --label security --label P1 --body-file "$work/issue.md"
    fi
    exit 0
  }

  # gh refuses to create an issue or PR with a label the repo doesn't have; fails harmlessly if it exists.
  gh label create security --color B60205 --description "Security gate and autofix" >/dev/null 2>&1 || true

  case "$(head -c 10 "$out/outcome" 2>/dev/null || true)" in
    skip) echo "Nothing to publish."; exit 0 ;;
    issue) open_issue "$(head -c 600 "$out/reason.txt" 2>/dev/null || true)" ;;
    pr) ;;
    *) open_issue "The autofix job didn't finish; see its log in the nightly run." ;;
  esac

  [[ -s "$out/change.patch" ]] || open_issue "The autofix job reported a fix but handed over no patch."
  git apply --binary "$out/change.patch" || open_issue "The proposed patch didn't apply to main."
  local changed
  changed="$(changed_paths)"
  [[ -n "$changed" ]] || open_issue "The proposed patch changed nothing."
  grep -qE "$FORBIDDEN" <<<"$changed" \
    && open_issue "The proposed patch touched files autofix may not edit: $(tr '\n' ' ' <<<"$changed")"

  git switch -q -c "$branch"
  git add -A
  git -c user.name="github-actions[bot]" -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
    commit -qm "Security autofix for the $date nightly" -m "Proposed by Claude from the security gate's findings; checked by scripts/security-autofix (unit tests, lint, security gate)."
  git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GH_TOKEN" | base64 -w0)" \
    push -q origin "HEAD:refs/heads/$branch"
  python3 -I "$work/body.py" "$work/findings.json" "" "$work/summary.md" pr >"$work/pr.md"
  gh pr create --head "$branch" --base main --label security \
    --title "Security autofix: $date nightly" --body-file "$work/pr.md"
  # PRs opened with the workflow token start no pull_request runs; start the tests by hand.
  gh workflow run tests.yml --ref "$branch"
}

# On one line: bash reads a script as it runs, and the patch publish applies may rewrite this file.
case "${1:-}" in propose|publish) mode="$1"; shift; "$mode" "$@"; exit ;; *) die "usage: scripts/security-autofix propose|publish <findings-dir> <out-dir>" ;; esac
