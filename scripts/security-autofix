#!/usr/bin/env bash
# The nightly's autofix: asks Claude to resolve a blocked security gate, checks the result itself,
# and opens a PR (or, when there's no safe fix, an issue). CI only; needs GH_TOKEN for the final
# push/PR/issue and ANTHROPIC_API_KEY for Claude.
#
#   scripts/security-autofix <findings-dir>     (the nightly security job's artifact)
#
# Credentials stay apart: Claude runs with the Anthropic key and no GitHub token, and the checks
# that execute its edits (Gradle runs build scripts it may have touched) see neither. Only the
# last step, after the checks pass, gets the GitHub token.
source "$(dirname "$0")/_lib.sh"

findings_dir="${1:?usage: scripts/security-autofix <findings-dir>}"
CLAUDE_CODE_VERSION=2.1.314
MODEL="${AUTOFIX_MODEL:-claude-opus-5-5}"
gh_token="${GH_TOKEN:?}"
anthropic_key="${ANTHROPIC_API_KEY:-}"
unset GH_TOKEN GITHUB_TOKEN ANTHROPIC_API_KEY
cd "$ROOT"

gate="$(find "$findings_dir" -name gate.json | head -1)"
codeql="$(find "$findings_dir" -name codeql.json | head -1)"
python3 -I - "${gate:-/dev/null}" "${codeql:-/dev/null}" .security-findings.json <<'EOF'
import json, sys
def load(p):
    try: return json.load(open(p))
    except Exception: return None
gate, codeql = load(sys.argv[1]) or {}, load(sys.argv[2]) or []
json.dump({"vulnerable_libraries": gate.get("blocking", []), "codeql_alerts": codeql}, open(sys.argv[3], "w"), indent=2)
EOF
trap 'rm -f .security-findings.json' EXIT
blocking="$(python3 -I -c 'import json; d=json.load(open(".security-findings.json")); print(len(d["vulnerable_libraries"]) + len(d["codeql_alerts"]))')"
date="$(date -u +%F)"
branch="security/autofix-$date"
work="$(mktemp -d)"
summary_md="$work/summary.md"
: >"$summary_md"

# Files a new issue, or adds the night's news to the one still open from an earlier night.
open_issue() { # open_issue <why>
  python3 -I scripts/security-autofix-body.py .security-findings.json "$1" "$summary_md" issue >"$work/issue.md"
  existing="$(GH_TOKEN="$gh_token" gh issue list --state open --label security --search 'in:title "Security gate blocked"' --json number --jq '.[0].number // empty')"
  if [[ -n "$existing" ]]; then
    GH_TOKEN="$gh_token" gh issue comment "$existing" --body-file "$work/issue.md"
  else
    GH_TOKEN="$gh_token" gh issue create --title "Security gate blocked the nightly (since $date)" --label security --label P1 --body-file "$work/issue.md"
  fi
  exit 0
}

# One fix in flight at a time: an open autofix PR means the next nightly just waits for it.
if GH_TOKEN="$gh_token" gh pr list --state open --json headRefName --jq '.[].headRefName' | grep -q '^security/autofix-'; then
  echo "An autofix PR is already open; not starting another."
  exit 0
fi
(( blocking > 0 )) || open_issue "The gate failed without findings to fix: the scan itself didn't run. See the nightly's Security job."
[[ -n "$anthropic_key" ]] || open_issue "CLAUDE_AUTOFIX_KEY isn't set, so no fix was attempted."

npm install --silent --no-audit --no-fund --prefix "$work/cli" "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION" >/dev/null
set +e
ANTHROPIC_API_KEY="$anthropic_key" "$work/cli/node_modules/.bin/claude" -p \
  "Resolve the blocking findings listed in .security-findings.json." \
  --bare --restricted --strict-mcp-config --no-session-persistence \
  --tools "Read,Grep,Glob,Edit,Write,Bash" \
  --allowedTools "Read" "Grep" "Glob" "Edit" "Write" "Bash(./gradlew:*)" "Bash(scripts/security-gate:*)" \
  --model "$MODEL" \
  --max-budget-usd "${AUTOFIX_BUDGET_USD:-10}" \
  --append-system-prompt-file security/autofix-prompt.md \
  --output-format json >"$work/answer.json" 2>"$work/stderr.txt"
rc=$?
set -e
python3 -I -c 'import json,sys; print(json.load(open(sys.argv[1])).get("result", "")[:3000])' "$work/answer.json" >"$summary_md" 2>/dev/null || true
(( rc == 0 )) || open_issue "Claude didn't finish (exit $rc)."

# Checked here, not taken on Claude's word.
changed="$(git status --porcelain --untracked-files=all | cut -c4-)"
[[ -n "$changed" ]] || open_issue "Claude found no safe fix and changed nothing."
if grep -qE '^(\.github/|signing/|security/|scripts/|CLAUDE\.md$|AGENTS\.md$)' <<<"$changed"; then
  open_issue "The proposed change touched files autofix may not edit: $(tr '\n' ' ' <<<"$changed")"
fi
./gradlew -q testDebugUnitTest lintRelease || open_issue "The proposed change broke the unit tests or lint."
scripts/security-gate >/dev/null || open_issue "The proposed change didn't clear the security gate."

git switch -q -c "$branch"
git add -A
git -c user.name="github-actions[bot]" -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
  commit -qm "Security autofix for the $date nightly" -m "Proposed by Claude from the security gate's findings; checked by scripts/security-autofix (unit tests, lint, security gate)."
git -c "http.https://github.com/.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$gh_token" | base64 -w0)" \
  push -q origin "HEAD:refs/heads/$branch"
python3 -I scripts/security-autofix-body.py .security-findings.json "" "$summary_md" pr >"$work/pr.md"
GH_TOKEN="$gh_token" gh pr create --head "$branch" --base main --label security \
  --title "Security autofix: $date nightly" --body-file "$work/pr.md"
# PRs opened with the workflow token start no pull_request runs; start the tests by hand.
GH_TOKEN="$gh_token" gh workflow run tests.yml --ref "$branch"
