#!/usr/bin/env bash
# Inspect Diurna's armed alarm, and stress it the way real nights do (backlog A1).
#   scripts/alarm-check            show what's armed and whether permissions are in place
#   scripts/alarm-check --doze     force deep sleep, then confirm the alarm is still armed
#   scripts/alarm-check --reboot   reboot, wait, then confirm the alarm was re-armed
source "$(dirname "$0")/_lib.sh"

pick_device

show() {
  local armed
  armed="$(adb shell dumpsys alarm | grep -A1 "$PKG/.alarm.AlarmReceiver" | grep -o 'origWhen=[^ ]* [^ ]*' | sed 's/origWhen=/  /' | sort -u || true)"
  if [[ -n "$armed" ]]; then
    echo "armed alarms:"; echo "$armed"
  else
    echo "armed alarms: none (porch code not confirmed, every day off, or something is wrong)"
  fi
  echo "permissions:"
  adb shell dumpsys package "$PKG" \
    | grep -E 'USE_EXACT_ALARM|USE_FULL_SCREEN_INTENT|POST_NOTIFICATIONS|CAMERA' | grep -o 'android.permission.[A-Z_]*: granted=[a-z]*' | sort -u | sed 's/^/  /'
}

case "${1:-}" in
  "") show ;;
  --doze)
    adb shell dumpsys deviceidle force-idle >/dev/null
    echo "deep sleep forced"
    show
    adb shell dumpsys deviceidle unforce >/dev/null
    echo "deep sleep released" ;;
  --reboot)
    adb reboot
    echo "rebooting..."
    adb wait-for-device
    for _ in $(seq 1 90); do
      [[ "$(adb shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" == 1 ]] && break
      sleep 2
    done
    sleep 10 # give the boot receiver time to re-arm
    show ;;
  *) die "usage: scripts/alarm-check [--doze|--reboot]" ;;
esac
