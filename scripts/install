#!/usr/bin/env bash
# Build, install and open Diurna. Prefers the phone over the emulator.
#   scripts/install               install and launch
#   scripts/install --no-launch   install only
source "$(dirname "$0")/_lib.sh"

pick_device
gradle installDebug
if [[ "${1:-}" != --no-launch ]]; then
  adb shell am start -n "$MAIN" >/dev/null
  echo "launched"
fi
