#!/usr/bin/env bash
# Show Diurna's logs.
#   scripts/logs           follow the app's log live (Ctrl-C to stop)
#   scripts/logs --crash   print recent crashes and exit
source "$(dirname "$0")/_lib.sh"

pick_device
if [[ "${1:-}" == --crash ]]; then
  adb logcat -d -b crash | grep -A40 "$PKG" || echo "no crashes for $PKG in the crash buffer"
  exit 0
fi

pid="$(adb shell pidof "$PKG" | tr -d '\r' || true)"
[[ -n "$pid" ]] || die "Diurna isn't running. Start it (scripts/install), then run this again."
adb logcat --pid="$pid"
