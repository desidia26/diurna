#!/usr/bin/env bash
# Copy Diurna's data off the device into backups/<timestamp>/ (git-ignored).
#
# Asks the app for a fresh backup (it opens briefly to do so), then pulls it from the app's folder
# in shared storage. That works for release builds too. Builds older than the self-backup feature
# fall back to reading the database directly, which only debug builds allow.
# Open the result with: sqlite3 backups/<ts>/daybook.db
source "$(dirname "$0")/_lib.sh"

pick_device
remote="/sdcard/Android/data/$PKG/files/backups"
dest="$ROOT/backups/$(date +%Y%m%d-%H%M%S)"

# No backups yet makes ls fail; that's an empty answer, not an error.
newest() { { adb shell "ls $remote/daybook-*.db 2>/dev/null" || true; } | tr -d '\r' | sort | tail -1; }

before="$(newest)"
# BackupTriggerActivity needs DUMP to start: adb shell has it, other apps on the phone don't.
started="$(adb shell am start -n "$PKG/app.diurna.BackupTriggerActivity" --ez backup true 2>&1 || true)"
# Builds up to release 47 don't have it and took the request on MainActivity instead. scripts/release
# backs up the installed (older) build before updating it, so keep asking the old way when needed.
# am's exit code differs between Android versions, so go by its output: any error means ask the old way.
if [[ "$started" == *Error* || "$started" == *Exception* ]]; then
  adb shell am start --activity-single-top -n "$(main_activity)" --ez backup true >/dev/null 2>&1 || true
fi
latest=""
for _ in $(seq 1 20); do
  sleep 1
  latest="$(newest)"
  [[ -n "$latest" && "$latest" != "$before" ]] && break
done

mkdir -p "$dest"
pulled=false
if [[ -n "$latest" && "$latest" != "$before" ]]; then
  sleep 1 # let the settings copy land next to it
  stamp="$(basename "$latest" .db)"; stamp="${stamp#daybook-}"
  if adb pull "$latest" "$dest/daybook.db" >/dev/null 2>&1; then
    adb pull "$remote/settings-$stamp.preferences_pb" "$dest/settings.preferences_pb" >/dev/null 2>&1 || true
    adb pull "$remote/food-photos" "$dest/" >/dev/null 2>&1 || true # meal photos, when there are any
    echo "fresh backup from the app ($stamp)"
    pulled=true
  fi
fi
if $pulled; then
  :
elif adb shell run-as "$PKG" true 2>/dev/null; then
  # Older debug build without self-backup: copy the files directly (all three, WAL included).
  for f in daybook.db daybook.db-wal daybook.db-shm; do
    if adb shell run-as "$PKG" test -f "databases/$f"; then
      adb exec-out run-as "$PKG" cat "databases/$f" >"$dest/$f"
    fi
  done
  echo "read directly (the app's own backup wasn't available; works on debug builds only)"
else
  rmdir "$dest" 2>/dev/null
  die "the app didn't produce a backup within 20s. Is it installed and able to start?"
fi

[[ -s "$dest/daybook.db" ]] || die "backup is empty"
echo "$dest"
if command -v sqlite3 >/dev/null; then
  sqlite3 "$dest/daybook.db" "SELECT 'days: '||COUNT(*) FROM day; SELECT 'workouts: '||COUNT(*) FROM day_workout; SELECT 'food entries: '||COUNT(*) FROM food_entry;"
fi
